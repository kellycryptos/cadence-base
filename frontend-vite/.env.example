# Cadence Base - Environment Variables

# Vault Contract Address (deploy the contract first, then add address here)
VITE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Base RPC URL (optional, defaults to public RPC)
VITE_BASE_RPC_URL=https://mainnet.base.org

# Cron Secret for Vercel Cron Jobs
CRON_SECRET=your-secret-here

# Database URL (if using Vercel Postgres or similar)
# DATABASE_URL=postgres://...

# Farcaster API Key (if implementing notifications)
# FARCASTER_API_KEY=your-api-key-here
