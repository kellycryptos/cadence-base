{
  "buildCommand": "cd frontend-vite && npm run build",
  "outputDirectory": "frontend-vite/dist",
  "devCommand": "cd frontend-vite && npm run dev",
  "installCommand": "cd frontend-vite && rm -rf node_modules package-lock.json && npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/.well-known/farcaster.json",
      "destination": "/frontend-vite/dist/.well-known/farcaster.json"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/farcaster.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/check-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}